// JK.Games V124 – ergänzender Firestore-Regelblock für Fight.KL.
// Diesen Block in die vorhandene firestore.rules übernehmen. Die bestehenden
// Regeln der App dürfen dabei nicht gelöscht oder durch diese Datei ersetzt werden.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownStaffRoleExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/staffRoles/$(request.auth.uid));
    }

    function ownStaffRole() {
      return ownStaffRoleExists()
        ? get(/databases/$(database)/documents/staffRoles/$(request.auth.uid)).data
        : null;
    }

    function isFightKlAdmin() {
      return ownStaffRoleExists()
        && ownStaffRole().active == true
        && ownStaffRole().role in ['admin', 'owner'];
    }

    // Der angemeldete Nutzer darf ausschließlich seine eigene Teamrolle lesen.
    // Rollen werden weiterhin nur durch die bereits vorhandene sichere
    // Teamverwaltung beziehungsweise Cloud Functions geschrieben.
    match /staffRoles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Optionales unveränderbares Audit-Log für spätere serverseitige
    // Fight.KL-Modaktionen.
    match /fightKlAdminLogs/{logId} {
      allow read, create: if isFightKlAdmin();
      allow update, delete: if false;
    }
  }
}
